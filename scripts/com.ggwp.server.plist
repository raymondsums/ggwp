<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ggwp.server</string>
    <!-- The mini's copy. Copy to ~/Library/LaunchAgents and load with
         launchctl bootstrap gui/$(id -u). Binds to 127.0.0.1 only; the game
         is reached from outside through Tailscale Funnel (scripts/funnel.sh). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/ray/ggwp/scripts/run.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/ray/ggwp</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd's bare PATH has none of the places the Claude CLI lives. -->
        <key>PATH</key>
        <string>/Users/ray/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PARKRACE_HOST</key>
        <string>127.0.0.1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/ray/ggwp/server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ray/ggwp/server.log</string>
</dict>
</plist>
